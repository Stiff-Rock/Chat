<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="rectangle">
    <!-- Use the theme's surface color for the background -->
    <solid android:color="@color/md_theme_dark_surface" />
    <!-- Optional: Add a subtle stroke using the onSurface color -->
    <stroke android:width="1dp" android:color="@color/md_theme_dark_onSurface" />
    <!-- Rounded corners to mimic WhatsApp's input field -->
    <corners android:radius="25dp" />
    <!-- Internal padding -->
    <padding
            android:left="12dp"
            android:top="8dp"
            android:right="12dp"
            android:bottom="8dp" />
</shape>
